[flake8]
# Configuración de Flake8 para control de calidad de código
max-line-length = 79
max-complexity = 10
extend-ignore = E203, W503, E501
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg,
    build,
    dist,
    .mypy_cache,
    .tox,
    notebooks

# Docstring conventions
docstring-convention = numpy

# Warnings
per-file-ignores =
    __init__.py:F401
    tests/*:D100,D101,D102,D103

# Count
count = True
statistics = True
